# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Raw physical archive camera dumps
data/**/raw_photos/
data/sample_pages/

# UAAP Archival book generated assets (PDFs, HTML viewers)
data/seasons/**/*.pdf
data/seasons/**/*.html

# Generated compiled book (rebuild with scripts/build_book_pdf_and_viewer.py)
data/compiled/UAAP_Complete_Digital_Book.html
data/compiled/UAAP_Complete_Digital_Book.md

# Generated historical standings compendium
UAAP_Historical_Standings_Compendium.html
UAAP_Historical_Standings_Compendium.pdf
data/compiled/UAAP_Historical_Standings_Compendium.html
data/compiled/UAAP_Historical_Standings_Compendium.pdf

# Local npm cache used by sandboxed installs
.npm-cache/

__pycache__/
*.pyc

# Claude Code local settings
.claude/settings.local.json

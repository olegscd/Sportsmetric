# Supabase — required for cross-browser admin sync
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER expose to the browser.
# Row-level security blocks writes from the anon key, so every admin write goes
# through /api/admin/mutate using this key. Without it the admin dashboard is
# read-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prefer ADMIN_PASSWORD_HASH; generate with npm run hash:admin-password (stdin).
# Format: scrypt$<salt>$<hash>. If set, it takes precedence over ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=
# Legacy password fallback for the /admin dashboard.
ADMIN_PASSWORD=choose-a-strong-password

# Extra exact HTTPS hostnames approved for team logos and player photos.
# Local /public paths, official PBA/UAAP hosts, and the Supabase project host
# are supported by default. Rebuild after changing this public setting.
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional search-engine ownership verification tokens (public meta tags).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
